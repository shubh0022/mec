generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  passwordHash    String?
  role            String   @default("SALES") // ADMIN, SALES, WAREHOUSE, ACCOUNTS, GUEST
  isActive        Boolean  @default(true)
  googleSubjectId String?  @unique
  avatarUrl       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdCustomers      Customer[]         @relation("CustomerCreator")
  createdFollowUps      CustomerFollowUp[] @relation("FollowUpCreator")
  createdStockMovements StockMovement[]    @relation("MovementCreator")
  createdChallans       SalesChallan[]     @relation("ChallanCreator")
  confirmedChallans     SalesChallan[]     @relation("ChallanConfirmer")
  auditLogs             AuditLog[]

  @@index([email])
  @@index([googleSubjectId])
  @@index([role])
}

model Customer {
  id           String    @id @default(cuid())
  customerCode String    @unique
  customerName String
  mobile       String
  email        String?
  businessName String
  gstNumber    String?
  customerType String    @default("WHOLESALE") // RETAIL, WHOLESALE, DISTRIBUTOR
  address      String
  status       String    @default("ACTIVE")    // LEAD, ACTIVE, INACTIVE
  followUpDate DateTime?
  notes        String?
  createdBy    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdByUser User               @relation("CustomerCreator", fields: [createdBy], references: [id])
  followUps     CustomerFollowUp[]
  challans      SalesChallan[]
  invoices      Invoice[]

  @@index([customerName])
  @@index([customerCode])
  @@index([mobile])
  @@index([email])
  @@index([status])
  @@index([customerType])
}

model CustomerFollowUp {
  id           String   @id @default(cuid())
  customerId   String
  note         String
  followUpDate DateTime
  createdBy    String
  createdAt    DateTime @default(now())

  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdByUser User     @relation("FollowUpCreator", fields: [createdBy], references: [id])

  @@index([customerId])
  @@index([followUpDate])
}

model Warehouse {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  location  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Category {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id           String   @id @default(cuid())
  productCode  String   @unique
  productName  String
  sku          String   @unique
  categoryId   String?
  unitPrice    Float    @default(0)
  currentStock Int      @default(0)
  minimumStock Int      @default(5)
  warehouseId  String?
  imageUrl     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       Category?          @relation(fields: [categoryId], references: [id])
  warehouse      Warehouse?         @relation(fields: [warehouseId], references: [id])
  stockMovements StockMovement[]
  challanItems   SalesChallanItem[]

  @@index([sku])
  @@index([productName])
  @@index([productCode])
  @@index([categoryId])
  @@index([currentStock])
}

model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  quantity      Int
  movementType  String   // IN, OUT
  reason        String
  referenceType String?  // SALES_CHALLAN, MANUAL_ADJUSTMENT, PURCHASE, INITIAL_STOCK
  referenceId   String?
  createdBy     String
  createdAt     DateTime @default(now())

  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  createdByUser User    @relation("MovementCreator", fields: [createdBy], references: [id])

  @@index([productId])
  @@index([createdAt])
  @@index([movementType])
  @@index([referenceId])
}

model SalesChallan {
  id            String    @id @default(cuid())
  challanNumber String    @unique
  customerId    String
  status        String    @default("DRAFT") // DRAFT, CONFIRMED, CANCELLED
  totalQuantity Int       @default(0)
  subTotal      Float     @default(0)
  totalAmount   Float     @default(0)
  notes         String?
  createdBy     String
  confirmedBy   String?
  confirmedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  customer        Customer           @relation(fields: [customerId], references: [id])
  createdByUser   User               @relation("ChallanCreator", fields: [createdBy], references: [id])
  confirmedByUser User?              @relation("ChallanConfirmer", fields: [confirmedBy], references: [id])
  items           SalesChallanItem[]
  invoice         Invoice?

  @@index([challanNumber])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model SalesChallanItem {
  id                  String @id @default(cuid())
  challanId           String
  productId           String
  productNameSnapshot String
  skuSnapshot         String
  unitPriceSnapshot   Float
  quantity            Int
  lineTotal           Float

  challan SalesChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([challanId])
  @@index([productId])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  challanId     String    @unique
  customerId    String
  status        String    @default("ISSUED") // ISSUED, PAID, CANCELLED
  subTotal      Float
  taxAmount     Float     @default(0)
  grandTotal    Float
  dueDate       DateTime?
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  challan  SalesChallan @relation(fields: [challanId], references: [id], onDelete: Restrict)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([invoiceNumber])
  @@index([customerId])
  @@index([status])
  @@index([issuedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  metadata  String?  // JSON string
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
}
